# ---------------------------------------------------------------------------
# PersoDash configuration. Copy to `.env` and fill in what you use.
# Only DATABASE_URL is required; every integration is
# optional and shows up as "not configured" in Settings when missing.
# ---------------------------------------------------------------------------

# Core ----------------------------------------------------------------------
DATABASE_URL="postgresql://persodash:change-me@localhost:5432/persodash"
# Protects /api/cron/* when triggered from an external scheduler (openssl rand -hex 32).
CRON_SECRET=""
# Encrypts secrets stored in the database, e.g. API keys in Actions
# (openssl rand -hex 32). Keep it stable – changing it makes stored secrets unreadable.
SECRETS_KEY=""
# Run miner polling + daily summary inside the app process.
# Default: on in production, off in development.
SCHEDULER_ENABLED=""

# First login bootstrap -----------------------------------------------------
# When no user exists yet, logging in with these credentials creates the
# account (password stored as scrypt hash). Remove them afterwards, or use
# `npm run user:create` instead.
DASHBOARD_USERNAME=""
DASHBOARD_PASSWORD=""

# Mining (Public Pool) ------------------------------------------------------
BTC_ADDRESS=""
# Session id of your own worker; highlighted in the UI.
WORKER=""

# Websites (Vercel) ---------------------------------------------------------
VERCEL_API_TOKEN=""
VERCEL_TEAM_ID=""

# Projects (GitHub) ---------------------------------------------------------
# Optional: fine-grained token with read-only "Contents" + "Pull requests"
# access. Needed for private repos; public repos work without it.
GITHUB_TOKEN=""

# Wallets -------------------------------------------------------------------
COINBASE_API_KEY_ID=""
COINBASE_API_KEY_SECRET=""
# Optional: SPL token portfolio for Solana wallets.
MORALIS_API_KEY=""
SOLANA_RPC_URL="https://api.mainnet-beta.solana.com"

# Notifications -------------------------------------------------------------
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Docker deployment ---------------------------------------------------------
# Used by docker-compose.yml (DATABASE_URL is then set automatically).
POSTGRES_PASSWORD=""
# Domain for the optional Caddy proxy profile (automatic HTTPS).
PERSODASH_DOMAIN=""
TZ="Europe/Berlin"
