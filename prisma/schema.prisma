// PersoDash data model (PostgreSQL)
//
// Conventions
// - ids: cuid strings
// - every mutable record has createdAt/updatedAt
// - tables are snake_case plural, columns stay camelCase (Prisma default)

generator client {
  provider            = "prisma-client"
  output              = "../app/generated/prisma"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Auth
// ---------------------------------------------------------------------------

model User {
  id           String    @id @default(cuid())
  username     String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]

  @@map("users")
}

/// Server-side session. Only the SHA-256 hash of the cookie token is stored.
model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent  String?
  ip         String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt  DateTime

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// ---------------------------------------------------------------------------
// Logbook
// ---------------------------------------------------------------------------

enum TripType {
  business
  private
}

model LogbookEntry {
  id          String   @id @default(cuid())
  date        DateTime @db.Date
  kilometers  Int
  description String
  type        TripType
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
  @@map("logbook_entries")
}

// ---------------------------------------------------------------------------
// Wallets
// ---------------------------------------------------------------------------

enum WalletChain {
  bitcoin
  solana
}

model Wallet {
  id        String      @id @default(cuid())
  label     String
  chain     WalletChain
  address   String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([chain, address])
  @@map("wallets")
}

// ---------------------------------------------------------------------------
// Notifications & monitoring
// ---------------------------------------------------------------------------

enum NotificationCategory {
  website
  miner
  wallet
  service
  subscription
  routine
  system
}

enum Severity {
  info
  warning
  error
}

model Notification {
  id        String               @id @default(cuid())
  category  NotificationCategory
  severity  Severity
  title     String
  message   String
  /// Free-form origin, e.g. "miner:<worker>"; useful for filtering.
  source    String
  readAt    DateTime?
  createdAt DateTime             @default(now())

  @@index([createdAt])
  @@index([readAt])
  @@map("notifications")
}

/// Tracks whether a monitored condition is currently failing so alerts are
/// sent on state transitions instead of on every poll.
model AlertState {
  key       String   @id
  active    Boolean
  since     DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("alert_states")
}

/// Periodic snapshot of the mining pool state; feeds the hashrate history.
model MinerSnapshot {
  id             String   @id @default(cuid())
  takenAt        DateTime @default(now())
  workerCount    Int
  totalHashrate  Float
  bestDifficulty Float
  /// Per-worker hashrate keyed by sessionId.
  workers        Json

  @@index([takenAt])
  @@map("miner_snapshots")
}

// ---------------------------------------------------------------------------
// Projects – the hub that other records can belong to
// ---------------------------------------------------------------------------

enum ProjectStatus {
  active
  paused
  idea
  done
}

model Project {
  id            String         @id @default(cuid())
  name          String
  description   String?
  status        ProjectStatus  @default(active)
  /// GitHub repository as "owner/name".
  repo          String?
  /// Name of the linked Vercel project (matched by name).
  vercelProject String?
  url           String?
  nextStep      String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  monitors      Monitor[]
  subscriptions Subscription[]
  notes         Note[]
  routines      Routine[]
  actions       HttpAction[]

  @@map("projects")
}

// ---------------------------------------------------------------------------
// Service monitors (uptime checks for self-hosted services)
// ---------------------------------------------------------------------------

model Monitor {
  id             String         @id @default(cuid())
  name           String
  url            String
  /// Exact status code to expect; null = any status below 400.
  expectedStatus Int?
  enabled        Boolean        @default(true)
  projectId      String?
  project        Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  checks         MonitorCheck[]

  @@map("monitors")
}

model MonitorCheck {
  id         String   @id @default(cuid())
  monitorId  String
  monitor    Monitor  @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  checkedAt  DateTime @default(now())
  ok         Boolean
  statusCode Int?
  latencyMs  Int?
  error      String?

  @@index([monitorId, checkedAt])
  @@map("monitor_checks")
}

// ---------------------------------------------------------------------------
// Subscriptions & recurring costs
// ---------------------------------------------------------------------------

enum BillingCycle {
  monthly
  quarterly
  yearly
}

model Subscription {
  id          String       @id @default(cuid())
  name        String
  /// Price per cycle in minor units (cents) to avoid float rounding.
  amountCents Int
  currency    String       @default("EUR")
  cycle       BillingCycle
  nextRenewal DateTime     @db.Date
  category    String?
  /// Days before renewal to send a reminder; 0 disables reminders.
  remindDays  Int          @default(7)
  active      Boolean      @default(true)
  url         String?
  projectId   String?
  project     Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([nextRenewal])
  @@map("subscriptions")
}

// ---------------------------------------------------------------------------
// Inbox – quick capture
// ---------------------------------------------------------------------------

model Note {
  id         String    @id @default(cuid())
  body       String
  pinned     Boolean   @default(false)
  /// Set when the note has been dealt with (archived).
  doneAt     DateTime?
  /// Where it was captured: app, api (token name) …
  source     String    @default("app")
  projectId  String?
  project    Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([doneAt, createdAt])
  @@map("notes")
}

// ---------------------------------------------------------------------------
// Routines – recurring tasks that reschedule themselves
// ---------------------------------------------------------------------------

enum RoutineCadence {
  daily
  weekly
  monthly
  quarterly
  yearly
}

model Routine {
  id          String              @id @default(cuid())
  title       String
  notes       String?
  cadence     RoutineCadence
  /// Every N cadence units, e.g. 2 + weekly = every other week.
  interval    Int                 @default(1)
  nextDue     DateTime            @db.Date
  /// Send a notification when it becomes due.
  remind      Boolean             @default(true)
  active      Boolean             @default(true)
  projectId   String?
  project     Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  completions RoutineCompletion[]

  @@index([nextDue])
  @@map("routines")
}

model RoutineCompletion {
  id        String   @id @default(cuid())
  routineId String
  routine   Routine  @relation(fields: [routineId], references: [id], onDelete: Cascade)
  /// The due date this completion satisfied.
  dueDate   DateTime @db.Date
  /// "done" or "skipped".
  outcome   String   @default("done")
  doneAt    DateTime @default(now())

  @@index([routineId, doneAt])
  @@index([doneAt])
  @@map("routine_completions")
}

// ---------------------------------------------------------------------------
// History for the weekly review
// ---------------------------------------------------------------------------

/// Daily total portfolio value, so the review can show the change over a week.
model PortfolioSnapshot {
  id      String   @id @default(cuid())
  day     DateTime @unique @db.Date
  totalEur Float

  @@map("portfolio_snapshots")
}

// ---------------------------------------------------------------------------
// Actions – saved HTTP requests against your own services, runnable as flows
// ---------------------------------------------------------------------------

enum HttpMethod {
  GET
  POST
  PUT
  PATCH
  DELETE
  HEAD
}

model HttpAction {
  id             String      @id @default(cuid())
  name           String
  method         HttpMethod  @default(GET)
  url            String
  /// [{ key, value, secret }] – secret values are AES-GCM encrypted.
  headers        Json        @default("[]")
  body           String?
  /// Exact status that counts as success; null = any 2xx/3xx.
  expectedStatus Int?
  projectId      String?
  project        Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  runs           ActionRun[]

  @@map("http_actions")
}

model ActionFlow {
  id            String      @id @default(cuid())
  name          String
  /// Ordered HttpAction ids.
  steps         String[]
  stopOnFailure Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  runs          ActionRun[]

  @@map("action_flows")
}

model ActionRun {
  id         String      @id @default(cuid())
  actionId   String?
  action     HttpAction? @relation(fields: [actionId], references: [id], onDelete: Cascade)
  flowId     String?
  flow       ActionFlow? @relation(fields: [flowId], references: [id], onDelete: Cascade)
  ok         Boolean
  status     Int?
  durationMs Int?
  error      String?
  /// First part of the response body.
  preview    String?
  /// app | flow | api:<token name>
  trigger    String      @default("app")
  startedAt  DateTime    @default(now())

  @@index([actionId, startedAt])
  @@index([flowId, startedAt])
  @@map("action_runs")
}

// ---------------------------------------------------------------------------
// API tokens for automations (LUCY, iOS Shortcuts, scripts)
// ---------------------------------------------------------------------------

model ApiToken {
  id         String    @id @default(cuid())
  name       String
  /// SHA-256 of the token; the token itself is shown once and never stored.
  tokenHash  String    @unique
  /// First characters of the token, to recognise it in the list.
  prefix     String
  scopes     String[]
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?

  @@map("api_tokens")
}

// ---------------------------------------------------------------------------
// Settings
// ---------------------------------------------------------------------------

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("settings")
}
